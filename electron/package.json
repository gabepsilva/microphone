{
  "name": "tagalong-electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "description": "Electron client for the TagAlong local JSON-RPC socket.",
  "scripts": {
    "build": "tsc -p tsconfig.json && bun build src/preload.ts --outfile=dist/preload.js --target=node --format=cjs --external electron",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "bun test",
    "test-coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage",
    "coverage-gate": "bun run tools/coverage_gate.ts",
    "start": "bun run build && electron --no-sandbox --disable-gpu --disable-gpu-sandbox --in-process-gpu --ozone-platform-hint=auto .",
    "dev": "bun run ./dev.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "electron": "43.4.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0"
  }
}
