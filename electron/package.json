{
  "name": "tagalong-electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "description": "Electron client for the TagAlong local JSON-RPC socket.",
  "scripts": {
    "build": "tsc -p tsconfig.json && bun build src/preload.ts --outfile=dist/preload.js --target=node --format=cjs --external electron",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "bun test",
    "test-coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage",
    "coverage-gate": "bun run tools/coverage_gate.ts",
    "start": "bun run build && electron --no-sandbox --disable-gpu --disable-gpu-sandbox --in-process-gpu ."
  },
  "devDependencies": {
    "@types/bun": "1.2.20",
    "@types/node": "22.18.0",
    "electron": "37.2.6",
    "eslint": "9.33.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.39.1"
  }
}
